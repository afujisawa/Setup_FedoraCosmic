[
  {
    "label": "check: all",
    "command": "bash",
    "args": [".zed/check.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
  },
  {
    "label": "shfmt: format current file",
    "command": "shfmt",
    "args": ["-i", "0", "-ci", "-bn", "-w", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "never",
  },
  {
    "label": "run: current file",
    "command": "bash",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
  },
]
